
# ==========================================
# VOXERA BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Groq Cloud API (Free tier from https://console.groq.com)
# Powers llama-3.3-70b-versatile for Domain Architecture Compilation, Structured Schema Extraction,
# and Pre-Deploy Adversarial Gauntlet Evaluation.
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs Conversational AI & Speech-to-Text (https://elevenlabs.io)
# Powers ElevenAgents live conversational voice runtime, Scribe STT, and Flash v2.5 TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Default Voice ID (Pre-configured human Indian / international voice)
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Telegram Bot Notification & Inline Action Approvals (Module 4)
# Create a bot via @BotFather in Telegram and get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Server Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=True
DATABASE_URL=sqlite+aiosqlite:///./voxera.db

# Phase 3: Ollama Local LLM Fallback
# When Groq is unreachable, compilation and refine fall back to local Ollama.
# Install Ollama (https://ollama.ai), then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Phase 4: Local STT via faster-whisper (fallback when ElevenLabs + Groq Whisper are down)
# pip install faster-whisper
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
# Device override (cpu or cuda). Default: cpu
# WHISPER_DEVICE=cpu
